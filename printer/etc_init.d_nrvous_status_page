#!/bin/sh /etc/rc.common
# OpenWrt procd init for the nrvous bridge status page.

START=97
STOP=11
USE_PROCD=1
DEPEND=fstab

PROG=/usr/local/bin/nrvous_status_page.py

start_service() {
    procd_open_instance nrvous_status_page
    procd_set_param env HOME=/root NRVOUS_STATUS_BIND="127.0.0.1" NRVOUS_STATUS_PORT="8765"
    procd_set_param command /usr/bin/python3 "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    # Self-healing, but don't flap forever if there's a persistent bug.
    procd_set_param respawn
    procd_set_param respawn_threshold 3600
    procd_set_param respawn_timeout 5
    procd_set_param respawn_retry 3
    procd_close_instance
}

stop_service() {
    for p in $(pgrep -f "python3 /usr/local/bin/nrvous_status_page.py"); do
        kill -9 "$p" 2>/dev/null || true
    done
}
